<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.chroniccare.controllers.PatientRdvController"
            prefWidth="1200" prefHeight="760"
            stylesheets="@home-styles.css">

    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="+" styleClass="brand-icon"/>
                    <Label text="ChronicCare" styleClass="brand-title"/>
                </HBox>
                <Label text="Suivi medical intelligent" styleClass="brand-subtitle"/>
            </VBox>
            <VBox styleClass="sidebar-user-card" spacing="6">
                <Label fx:id="sidebarAvatar" styleClass="sidebar-avatar"/>
                <Label fx:id="sidebarUserName" styleClass="sidebar-user-name"/>
                <Label text="Patient" styleClass="sidebar-role-badge"/>
            </VBox>
            <Separator styleClass="sidebar-sep"/>
            <VBox styleClass="nav-section" spacing="2" VBox.vgrow="ALWAYS">
                <Label text="NAVIGATION" styleClass="nav-section-label"/>
                <Button text="Accueil" styleClass="nav-btn" onAction="#goToHome" maxWidth="Infinity"/>
                <Button text="Mon profil" styleClass="nav-btn" onAction="#goToProfile" maxWidth="Infinity"/>
                <Label text="MES SOINS" styleClass="nav-section-label"/>
                <Button text="Evenements" styleClass="nav-btn" onAction="#goToPatientEvents" maxWidth="Infinity"/>
                <Button text="Mes inscriptions" styleClass="nav-btn" onAction="#goToPatientRegistrations" maxWidth="Infinity"/>
                <Button text="Mon suivi RDV" styleClass="nav-btn, nav-btn-active" onAction="#goToPatientFollowup" maxWidth="Infinity"/>
                <Button text="Prendre RDV" styleClass="nav-btn, nav-btn-active" onAction="#goToPatientBookRdv" maxWidth="Infinity"/>
                <Button text="Mes consultations" styleClass="nav-btn" onAction="#goToPatientConsultations" maxWidth="Infinity"/>
            </VBox>
            <VBox styleClass="sidebar-bottom">
                <Separator styleClass="sidebar-sep"/>
                <Button text="Deconnexion" styleClass="nav-btn, nav-btn-logout" onAction="#handleLogout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content" spacing="0">
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <Label text="Prendre rendez-vous nutrition" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="topbarDate" styleClass="topbar-date"/>
                <HBox styleClass="topbar-user-pill" alignment="CENTER" spacing="8">
                    <Label fx:id="topbarAvatar" styleClass="topbar-avatar"/>
                    <Label fx:id="topbarUserName" styleClass="topbar-username"/>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll">
                <VBox spacing="20" styleClass="dashboard-body">
                    <HBox spacing="18">
                        <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS">
                            <Label text="Nouvelle demande" styleClass="card-title"/>
                            <Separator/>
                            <VBox spacing="6">
                                <Label text="Nutritionniste" styleClass="info-label"/>
                                <ComboBox fx:id="nutritionistCombo" maxWidth="Infinity" styleClass="filter-combo"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label text="Motif" styleClass="info-label"/>
                                <TextArea fx:id="motifArea" prefRowCount="4" wrapText="true"/>
                            </VBox>
                            <HBox spacing="16">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Date souhaitee" styleClass="info-label"/>
                                    <DatePicker fx:id="requestedDatePicker" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Heure souhaitee" styleClass="info-label"/>
                                    <ComboBox fx:id="requestedTimeCombo" maxWidth="Infinity" styleClass="filter-combo"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="16">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Niveau d'urgence" styleClass="info-label"/>
                                    <ComboBox fx:id="urgencyCombo" maxWidth="Infinity" styleClass="filter-combo"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Type de suivi" styleClass="info-label"/>
                                    <ComboBox fx:id="followUpCombo" maxWidth="Infinity" styleClass="filter-combo"/>
                                </VBox>
                            </HBox>
                            <VBox spacing="6">
                                <Label text="Rappel des informations medicales" styleClass="info-label"/>
                                <Label fx:id="medicalSummaryLabel" wrapText="true" styleClass="info-value"/>
                            </VBox>
                            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
                            <Label fx:id="successLabel" styleClass="success-label" wrapText="true"/>
                            <Button text="Envoyer la demande" styleClass="btn-primary" onAction="#handleSubmit"/>
                        </VBox>

                        <VBox styleClass="card, card-tips" spacing="12" prefWidth="320">
                            <Label text="Details de la demande selectionnee" styleClass="card-title"/>
                            <Separator/>
                            <VBox spacing="6">
                                <Label text="Statut" styleClass="info-label"/>
                                <Label fx:id="selectedStatusLabel" styleClass="info-value"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label text="Nutritionniste" styleClass="info-label"/>
                                <Label fx:id="selectedNutritionistLabel" styleClass="info-value"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label text="Creneau demande" styleClass="info-label"/>
                                <Label fx:id="selectedRequestedLabel" styleClass="info-value"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label text="Creneau retenu" styleClass="info-label"/>
                                <Label fx:id="selectedScheduledLabel" styleClass="info-value"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label text="Type de suivi" styleClass="info-label"/>
                                <Label fx:id="selectedFollowUpLabel" styleClass="info-value"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label text="Retour du nutritionniste" styleClass="info-label"/>
                                <TextArea fx:id="selectedResponseArea" editable="false" wrapText="true" prefRowCount="7"/>
                            </VBox>
                        </VBox>
                    </HBox>

                    <VBox styleClass="card" spacing="16">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Suivi de mes demandes RDV" styleClass="card-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Les demandes en attente sont affichees en premier." styleClass="stat-sub"/>
                        </HBox>
                        <Separator/>
                        <TableView fx:id="appointmentTable" styleClass="dashboard-table" prefHeight="320">
                            <columns>
                                <TableColumn fx:id="colNutritionist" text="Nutritionniste" prefWidth="220"/>
                                <TableColumn fx:id="colRequested" text="Creneau souhaite" prefWidth="180"/>
                                <TableColumn fx:id="colStatus" text="Statut" prefWidth="170"/>
                                <TableColumn fx:id="colUrgency" text="Urgence" prefWidth="140"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
