<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.chroniccare.controllers.AdminShellController" prefWidth="1200" prefHeight="760" stylesheets="@home-styles.css">

    <left>
        <VBox fx:id="sidebarRoot" styleClass="sidebar" prefWidth="230" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="+" styleClass="brand-icon"/>
                    <Label text="ChronicCare" styleClass="brand-title"/>
                </HBox>
                <Label text="Espace administrateur" styleClass="brand-subtitle"/>
            </VBox>

            <VBox styleClass="sidebar-user-card" spacing="6" alignment="CENTER_LEFT">
                <Label fx:id="sidebarAvatar" styleClass="sidebar-avatar"/>
                <Label fx:id="sidebarUserName" styleClass="sidebar-user-name"/>
                <Label fx:id="sidebarRoleBadge" styleClass="sidebar-role-badge"/>
            </VBox>

            <Separator styleClass="sidebar-sep"/>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" pannable="true" styleClass="sidebar-nav-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox styleClass="nav-section" spacing="2">
                        <Label text="TABLEAU DE BORD" styleClass="nav-section-label"/>
                        <Button fx:id="btnHome" text="🏠  Accueil" styleClass="nav-btn" onAction="#showHome" maxWidth="Infinity"/>
                        <Button fx:id="btnProfile" text="👤  Mon profil" styleClass="nav-btn" onAction="#showProfile" maxWidth="Infinity"/>

                        <Label text="ADMINISTRATION" styleClass="nav-section-label"/>
                        <Button fx:id="btnUsers" text="👥  Gestion utilisateurs" styleClass="nav-btn" onAction="#showUsers" maxWidth="Infinity"/>
                        <Button fx:id="btnBlocked" text="🔒  Comptes bloques" styleClass="nav-btn" onAction="#showBlocked" maxWidth="Infinity"/>
                        <Button fx:id="btnAudit" text="📝  Audit medical" styleClass="nav-btn" onAction="#showAudit" maxWidth="Infinity"/>
                        <Button fx:id="btnSegment" text="🧩  Segmentation patients" styleClass="nav-btn" onAction="#showSegmentation" maxWidth="Infinity"/>
                        <Button fx:id="btnStats" text="📊  Statistiques" styleClass="nav-btn" onAction="#showStats" maxWidth="Infinity"/>

                        <Label text="SUIVI MEDICAL" styleClass="nav-section-label"/>
                        <Button fx:id="btnEtat" text="📋  Etat patients" styleClass="nav-btn" onAction="#showEtat" maxWidth="Infinity"/>
                        <Button fx:id="btnActivite" text="🏃  Activite patients" styleClass="nav-btn" onAction="#showActivite" maxWidth="Infinity"/>

                        <Label text="NUTRITION" styleClass="nav-section-label"/>
                        <Button fx:id="btnConsult" text="📋  Consultations patient" styleClass="nav-btn" onAction="#showConsultations" maxWidth="Infinity"/>
                        <Button fx:id="btnRdv" text="📆  RDV nutrition" styleClass="nav-btn" onAction="#showRdv" maxWidth="Infinity"/>

                        <Label text="BOUTIQUE" styleClass="nav-section-label"/>
                        <Button fx:id="btnProducts" text="🛍  Produits" styleClass="nav-btn" onAction="#showProducts" maxWidth="Infinity"/>
                        <Button fx:id="btnAddProduct" text="➕  Ajouter produit" styleClass="nav-btn" onAction="#showAddProduct" maxWidth="Infinity"/>
                        <Button fx:id="btnOrders" text="🧾  Commandes" styleClass="nav-btn" onAction="#showOrders" maxWidth="Infinity"/>
                        <Button fx:id="btnDeliveries" text="🚚  Livraisons" styleClass="nav-btn" onAction="#showDeliveries" maxWidth="Infinity"/>
                    </VBox>
                </content>
            </ScrollPane>

            <VBox styleClass="sidebar-bottom">
                <Separator styleClass="sidebar-sep"/>
                <Button text="⏻  Deconnexion" styleClass="nav-btn, nav-btn-logout" onAction="#handleLogout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content" spacing="0">
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <Label fx:id="pageTitle" text="Tableau de bord" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="topbarDate" styleClass="topbar-date"/>
                <HBox styleClass="topbar-user-pill" alignment="CENTER" spacing="8">
                    <Label fx:id="topbarAvatar" styleClass="topbar-avatar"/>
                    <Label fx:id="topbarUserName" styleClass="topbar-username"/>
                </HBox>
            </HBox>
            <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

</BorderPane>
