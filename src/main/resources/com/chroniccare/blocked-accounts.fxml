<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.chroniccare.controllers.BlockedAccountsController"
            stylesheets="@home-styles.css">

    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="4">
                <Label text="ChronicCare" styleClass="brand-title"/>
            </VBox>

            <VBox styleClass="nav-section" spacing="6" VBox.vgrow="ALWAYS">
                <Button text="🏠 Accueil" styleClass="nav-btn" onAction="#goToHome" maxWidth="Infinity"/>
                <Button text="👥 Gestion Utilisateurs" styleClass="nav-btn" onAction="#goToUsers" maxWidth="Infinity"/>
                <Button text="🔒 Comptes bloqués" styleClass="nav-btn nav-btn-active" onAction="#goToBlockedAccounts" maxWidth="Infinity"/>
                <Button text="📝 Audit médical" styleClass="nav-btn" onAction="#goToMedicalAudit" maxWidth="Infinity"/>
                <Button text="📊 Statistiques" styleClass="nav-btn" onAction="#goToStats" maxWidth="Infinity"/>
            </VBox>

            <Button text="Déconnexion" styleClass="nav-btn" onAction="#handleLogout" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="15" style="-fx-padding:20;">
            <Label text="Comptes bloqués" style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <TableView fx:id="blockedTable"
                       VBox.vgrow="ALWAYS"
                       styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="nomCol" text="Nom" prefWidth="130"/>
                    <TableColumn fx:id="prenomCol" text="Prénom" prefWidth="130"/>
                    <TableColumn fx:id="emailCol" text="Email" prefWidth="230"/>
                    <TableColumn fx:id="reasonCol" text="Cause du blocage" prefWidth="320"/>
                    <TableColumn fx:id="blockedUntilCol" text="Bloqué jusqu'à" prefWidth="170"/>
                    <TableColumn fx:id="modeCol" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="actionsCol" text="Actions" prefWidth="220"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
