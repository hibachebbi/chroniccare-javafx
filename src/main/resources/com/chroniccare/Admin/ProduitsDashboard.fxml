<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chroniccare.controllers.Admin.ProduitsDashboardController"
      spacing="15"
      style="-fx-padding: 30; -fx-background-color: #f0f4ff;">

    <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Gestion des produits"
                   style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🏠 Accueil"
                    onAction="#goToHome"
                    style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="🧾 Commandes"
                    onAction="#goToCommandes"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="+ Ajouter"
                    onAction="#goToAdd"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="Deconnexion"
                    onAction="#goToLogin"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Rechercher par nom ou categorie..."
                       style="-fx-pref-height: 38; -fx-font-size: 13;" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="categorieFilter" promptText="Categorie"
                      style="-fx-pref-width: 220; -fx-pref-height: 38;"/>
            <Button text="Rechercher" onAction="#handleSearch"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13; -fx-padding: 8 16; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="Reinitialiser" onAction="#handleReset"
                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-size: 13; -fx-padding: 8 16; -fx-cursor: hand; -fx-background-radius: 8;"/>
        </HBox>

        <TableView fx:id="productsTable" VBox.vgrow="ALWAYS" style="-fx-font-size: 13;">
            <columns>
                <TableColumn fx:id="nomCol" text="Nom" prefWidth="180"/>
                <TableColumn fx:id="categorieCol" text="Categorie" prefWidth="170"/>
                <TableColumn fx:id="prixCol" text="Prix" prefWidth="110"/>
                <TableColumn fx:id="stockCol" text="Stock" prefWidth="90"/>
                <TableColumn fx:id="statutCol" text="Statut" prefWidth="110"/>
                <TableColumn fx:id="activeCol" text="Actif" prefWidth="90"/>
                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="190"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER" spacing="10">
            <Button text="◀ Precedent" onAction="#previousPage"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13; -fx-padding: 8 16; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Label fx:id="pageLabel" text="Page 1" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
            <Button text="Suivant ▶" onAction="#nextPage"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13; -fx-padding: 8 16; -fx-cursor: hand; -fx-background-radius: 8;"/>
        </HBox>

        <Label fx:id="countLabel" style="-fx-font-size: 12; -fx-text-fill: #666;"/>

    </children>
</VBox>


