<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chroniccare.controllers.Admin.AjouterProduit" prefWidth="1100" prefHeight="720" style="-fx-background-color: #f0f4ff;">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 20 24; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <Label text="Ajouter un produit" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Retour" onAction="#goToProduits" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 18;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18" style="-fx-padding: 24;">
            <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22; -fx-border-color: #e2e8f0; -fx-border-radius: 16;">
                <Label text="Créer un nouveau produit" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Label text="Renseignez les informations ci-dessous pour ajouter le produit au catalogue." style="-fx-text-fill: #64748b;"/>
                <Separator/>

                <VBox spacing="14">
                    <TextField fx:id="nomField" promptText="Nom du produit" style="-fx-pref-height: 40; -fx-background-radius: 8;"/>
                    <ComboBox fx:id="categorieCombo" promptText="Catégorie" style="-fx-pref-height: 40; -fx-pref-width: 100%;"/>
                    <TextField fx:id="prixField" promptText="Prix" style="-fx-pref-height: 40; -fx-background-radius: 8;"/>
                    <Spinner fx:id="stockSpinner" editable="true" prefHeight="40"/>
                    <TextArea fx:id="descriptionArea" promptText="Description" prefRowCount="6" wrapText="true" style="-fx-background-radius: 8;"/>

                    <Label fx:id="errorLabel" text="" style="-fx-text-fill: #dc2626; -fx-font-weight: bold;" wrapText="true"/>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Annuler" onAction="#goToProduits" style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 18;"/>
                        <Button text="Ajouter" onAction="#handleAdd" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 18;"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
