<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root" xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.chroniccare.controllers.Client.CommandesDashboardController"
          spacing="18"
          styleClass="products-page, commandes-page">

        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="welcome-banner">
                <Label text="🧾" styleClass="banner-emoji"/>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Mes commandes" styleClass="welcome-title"/>
                        <Label text="Suivez l'état de vos commandes, relancez un paiement ou demandez une annulation."
                                   styleClass="welcome-subtitle" wrapText="true"/>
                </VBox>
                <Label text="PATIENT" styleClass="sidebar-role-badge, sidebar-role-patient"/>
        </HBox>

        <VBox spacing="14" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Historique des commandes" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Accueil" onAction="#goToHome" styleClass="btn-neutral"/>
                        <Button text="Produits" onAction="#goToProduits" styleClass="btn-primary"/>
                        <Button text="Panier" onAction="#goToPanier" styleClass="btn-primary"/>
                        <Button text="Livraisons" onAction="#goToLivraisons" styleClass="btn-primary"/>
                        <Button text="Deconnexion" onAction="#goToLogin" styleClass="btn-danger"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Rechercher par numero commande..."
                                           styleClass="filter-field, products-search-field" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="statutFilter" promptText="Statut"
                                          styleClass="filter-combo, products-filter-combo"/>
                        <Button text="Rechercher" onAction="#handleSearch" styleClass="btn-primary"/>
                        <Button text="Reinitialiser" onAction="#handleReset" styleClass="btn-secondary"/>
                </HBox>

                <Separator/>

                <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS" styleClass="modern-table, commandes-table">
                        <columns>
                                <TableColumn fx:id="statutCol" text="Statut" prefWidth="120"/>
                                <TableColumn fx:id="totalCol" text="Total" prefWidth="100"/>
                                <TableColumn fx:id="paiementCol" text="Paiement" prefWidth="120"/>
                                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="320"/>
                        </columns>
                </TableView>

                <HBox alignment="CENTER" spacing="10" styleClass="products-pagination-row">
                        <Button text="◀ Precedent" onAction="#previousPage" styleClass="btn-secondary"/>
                        <Label fx:id="pageLabel" text="Page 1" styleClass="products-page-label"/>
                        <Button text="Suivant ▶" onAction="#nextPage" styleClass="btn-primary"/>
                </HBox>
        </VBox>

        <Label fx:id="countLabel" styleClass="products-count-label"/>

</VBox>

