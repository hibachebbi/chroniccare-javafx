<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chroniccare.controllers.Client.ProduitDetailController"
      spacing="15"
      style="-fx-padding: 30; -fx-background-color: #f0f4ff;">

    <!-- Navigation Bar -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button text="◀ Retour" onAction="#goBack"
                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
        <Label text="Détails du produit"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🏠 Accueil" onAction="#goToHome"
                style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
        <Button text="🧾 Commandes" onAction="#goToCommandes"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
        <Button text="🧺 Panier" onAction="#goToPanier"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
        <Button text="❤️ Wishlist" onAction="#goToWishlist"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
        <Button text="Deconnexion" onAction="#goToLogin"
                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
    </HBox>

    <Separator/>

    <!-- Product Details Content -->
    <VBox spacing="15" style="-fx-border-color: #2563eb; -fx-border-width: 2; -fx-padding: 20; -fx-border-radius: 8; -fx-background-color: white;">

        <!-- Title and Wishlist Button -->
        <HBox alignment="TOP_LEFT" spacing="15">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label fx:id="nomLabel" text="Nom du produit"
                       style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label fx:id="categorieLabel" text="Catégorie"
                       style="-fx-font-size: 14; -fx-text-fill: #666; -fx-font-style: italic;"/>
            </VBox>

            <!-- Wishlist Heart Button -->
            <Button fx:id="wishlistBtn" text="❤️ Ajouter aux favoris" onAction="#toggleWishlist"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 12 18; -fx-cursor: hand; -fx-background-radius: 8;">
                <tooltip>
                    <Tooltip text="Ajouter ce produit à votre wishlist"/>
                </tooltip>
            </Button>
        </HBox>

        <Separator/>

        <!-- Price and Stock -->
        <HBox spacing="40" alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label text="Prix:" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                <Label fx:id="prixLabel" text="0.00 €" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
            </VBox>

            <Separator orientation="VERTICAL"/>

            <VBox spacing="5">
                <Label text="Stock disponible:" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                <Label fx:id="stockLabel" text="0" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
            </VBox>

            <Separator orientation="VERTICAL"/>

            <VBox spacing="5">
                <Label text="Statut:" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                <Label fx:id="statutLabel" text="Disponible" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
            </VBox>
        </HBox>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label text="Quantité:" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                <Spinner fx:id="qtySpinner" prefWidth="110"/>
            </VBox>
        </HBox>

        <Separator/>

        <!-- Description -->
        <VBox spacing="8">
            <Label text="Description:" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <TextArea fx:id="descriptionArea" wrapText="true" editable="false"
                      style="-fx-control-inner-background: #f9fafb; -fx-font-size: 13; -fx-text-fill: #333; -fx-padding: 10; -fx-border-color: #d1d5db; -fx-border-radius: 4;"
                      VBox.vgrow="ALWAYS"/>
        </VBox>

        <Separator/>

        <!-- Action Buttons -->
        <HBox spacing="15" alignment="CENTER">
            <Button text="💳 Commander maintenant" onAction="#commanderMaintenant"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="🛒 Ajouter au panier" onAction="#ajouterAuPanier"
                    style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-padding: 12 20; -fx-cursor: hand; -fx-background-radius: 8;"/>
        </HBox>
    </VBox>

    <!-- Bottom Message -->
    <Label fx:id="messageLabel" style="-fx-font-size: 12; -fx-text-fill: #666; -fx-padding: 10;"/>

</VBox>


