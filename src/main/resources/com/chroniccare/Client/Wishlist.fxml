<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chroniccare.controllers.Client.WishlistController"
            fx:id="root"
            styleClass="wishlist-page">

    <top>
        <VBox spacing="18" styleClass="products-page">
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="welcome-banner">
                <Label text="❤️" styleClass="banner-emoji"/>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Ma wishlist" styleClass="welcome-title"/>
                    <Label text="Gardez vos produits préférés à portée de main et envoyez-les rapidement dans le panier."
                           styleClass="welcome-subtitle" wrapText="true"/>
                </VBox>
                <Label text="PATIENT" styleClass="sidebar-role-badge, sidebar-role-patient"/>
            </HBox>

            <VBox spacing="14" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Favoris enregistrés" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Accueil" onAction="#goToHome" styleClass="btn-neutral"/>
                    <Button text="Produits" onAction="#goToProduits" styleClass="btn-primary"/>
                    <Button text="Commandes" onAction="#goToCommandes" styleClass="btn-primary"/>
                    <Button text="Panier" onAction="#goToPanier" styleClass="btn-primary"/>
                    <Button text="Deconnexion" onAction="#goToLogin" styleClass="btn-danger"/>
                </HBox>
                <Separator/>
                <Label fx:id="countLabel" text="Total: 0 produit(s) dans votre wishlist" styleClass="products-count-label"/>
            </VBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="14" styleClass="card wishlist-center-card">
            <Label fx:id="emptyLabel" text="Votre wishlist est vide. Ajoutez des produits!"
                   visible="true" managed="true"
                   styleClass="wishlist-empty-label"/>

            <TableView fx:id="wishlistTable" VBox.vgrow="ALWAYS" styleClass="modern-table, wishlist-table">
                <columns>
                    <TableColumn fx:id="nomCol" text="Nom du produit" prefWidth="300"/>
                    <TableColumn fx:id="prixCol" text="Prix" prefWidth="100"/>
                    <TableColumn fx:id="stockCol" text="Stock" prefWidth="100"/>
                    <TableColumn fx:id="actionsCol" text="Actions" prefWidth="280"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" styleClass="wishlist-footer" alignment="CENTER">
            <Label text="💡 Utilisez votre wishlist pour garder vos produits préférés en un seul endroit"
                   styleClass="products-count-label"/>
        </HBox>
    </bottom>

</BorderPane>
