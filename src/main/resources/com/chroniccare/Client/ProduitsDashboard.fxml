<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chroniccare.controllers.Client.ProduitsDashboardController" spacing="18" styleClass="products-page">

        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="welcome-banner">
                <Label text="🛍" styleClass="banner-emoji"/>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Boutique" styleClass="welcome-title"/>
                        <Label text="Consultez les produits, ajoutez au panier et gérez vos commandes en un coup d'oeil." styleClass="welcome-subtitle" wrapText="true"/>
                </VBox>
                <Label text="PATIENT" styleClass="sidebar-role-badge, sidebar-role-patient"/>
        </HBox>

        <VBox spacing="14" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Catalogue produits" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Accueil" onAction="#goToHome" styleClass="btn-neutral"/>
                        <Button text="Commandes" onAction="#goToCommandes" styleClass="btn-primary"/>
                        <Button text="Panier" onAction="#goToPanier" styleClass="btn-primary"/>
                        <Button text="Wishlist" onAction="#goToWishlist" styleClass="btn-danger"/>
                        <Button text="Deconnexion" onAction="#goToLogin" styleClass="btn-danger"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Rechercher par nom ou categorie..." styleClass="filter-field, products-search-field" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="categorieFilter" promptText="Categorie" styleClass="filter-combo, products-filter-combo"/>
                        <Button text="Rechercher" onAction="#handleSearch" styleClass="btn-primary"/>
                        <Button text="Reinitialiser" onAction="#handleReset" styleClass="btn-secondary"/>
                </HBox>

                <Separator/>

                <TableView fx:id="productsTable" VBox.vgrow="ALWAYS" styleClass="modern-table, products-table">
                        <columns>
                                <TableColumn fx:id="nomCol" text="Nom" prefWidth="180"/>
                                <TableColumn fx:id="categorieCol" text="Categorie" prefWidth="170"/>
                                <TableColumn fx:id="prixCol" text="Prix" prefWidth="110"/>
                                <TableColumn fx:id="stockCol" text="Stock" prefWidth="90"/>
                                <TableColumn fx:id="statutCol" text="Statut" prefWidth="120"/>
                                <TableColumn fx:id="actionsCol" text="Actions" prefWidth="280"/>
                        </columns>
                </TableView>

                <HBox alignment="CENTER" spacing="10" styleClass="products-pagination-row">
                        <Button text="◀ Precedent" onAction="#previousPage" styleClass="btn-secondary"/>
                        <Label fx:id="pageLabel" text="Page 1" styleClass="products-page-label"/>
                        <Button text="Suivant ▶" onAction="#nextPage" styleClass="btn-primary"/>
                </HBox>
        </VBox>

        <Label fx:id="countLabel" styleClass="products-count-label"/>

</VBox>

