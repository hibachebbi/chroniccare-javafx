<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.Client.PanierController"
      spacing="16.0"
      styleClass="dashboard-page">

    <padding>
        <Insets top="18.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <children>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <Button text="⌂ Accueil" onAction="#goToHome" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="📄 Commandes" onAction="#goToCommandes" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="🛍 Catalogue" onAction="#goToCatalogue" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="Deconnexion" onAction="#goToLogin" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
        </HBox>

        <Label text="Mon panier" styleClass="page-title"/>

        <TableView fx:id="cartTable" prefHeight="440.0" editable="true">
            <columns>
                <TableColumn fx:id="colNom" text="Produit" prefWidth="260.0"/>
                <TableColumn fx:id="colQty" text="Qte" prefWidth="80.0"/>
                <TableColumn fx:id="colPrix" text="Prix" prefWidth="100.0"/>
                <TableColumn fx:id="colTotal" text="Total" prefWidth="120.0"/>
            </columns>
        </TableView>

        <HBox spacing="12.0">
            <Label fx:id="totalLabel" text="Total: 0.00" styleClass="section-title"/>
            <HBox spacing="10.0">
                <Button text="Retirer" onAction="#removeSelected"/>
                <Button text="Vider" onAction="#clearCart"/>
                <Button text="Valider commande" onAction="#checkoutInfo" styleClass="cc-btn"/>
            </HBox>
        </HBox>

        <Label text="Note: double-clic sur une ligne = modifier la quantite." styleClass="muted"/>
    </children>
</VBox>
