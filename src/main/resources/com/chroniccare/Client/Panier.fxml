<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chroniccare.controllers.Client.PanierController" spacing="18.0" styleClass="products-page, panier-page">

    <children>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="welcome-banner">
            <Label text="🧺" styleClass="banner-emoji"/>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Mon panier" styleClass="welcome-title"/>
                <Label text="Vérifiez vos articles, ajustez les quantités et validez votre commande en toute simplicité." styleClass="welcome-subtitle" wrapText="true"/>
            </VBox>
            <Label text="PATIENT" styleClass="sidebar-role-badge, sidebar-role-patient"/>
        </HBox>

        <VBox spacing="14" styleClass="card">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Articles du panier" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Accueil" onAction="#goToHome" styleClass="btn-neutral"/>
                <Button text="Commandes" onAction="#goToCommandes" styleClass="btn-primary"/>
                <Button text="Catalogue" onAction="#goToCatalogue" styleClass="btn-primary"/>
                <Button text="Deconnexion" onAction="#goToLogin" styleClass="btn-danger"/>
            </HBox>

            <Separator/>

            <TableView fx:id="cartTable" prefHeight="460.0" editable="true" styleClass="modern-table, panier-table">
                <columns>
                    <TableColumn fx:id="colNom" text="Produit" prefWidth="300.0"/>
                    <TableColumn fx:id="colQty" text="Qte" prefWidth="90.0"/>
                    <TableColumn fx:id="colPrix" text="Prix" prefWidth="120.0"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="130.0"/>
                </columns>
            </TableView>

            <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="panier-footer-row">
                <Label fx:id="totalLabel" text="Total: 0.00" styleClass="panier-total-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Retirer" onAction="#removeSelected" styleClass="btn-secondary"/>
                <Button text="Vider" onAction="#clearCart" styleClass="btn-secondary"/>
                <Button text="Valider commande" onAction="#checkoutInfo" styleClass="btn-primary"/>
            </HBox>

            <Label text="Note: double-clic sur une ligne = modifier la quantite." styleClass="products-count-label"/>
        </VBox>

    </children>
</VBox>
