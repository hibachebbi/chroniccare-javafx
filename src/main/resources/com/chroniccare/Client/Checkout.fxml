<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chroniccare.controllers.Client.CheckoutController"
      spacing="18.0"
      style="-fx-background-color: #f3f4f6;">

    <padding>
        <Insets top="16.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <children>
        <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 4 0 0 0;">
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Accueil" onAction="#goToHome" style="-fx-background-color: #111827; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="Commandes" onAction="#goToCommandes" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="Panier" onAction="#goToPanier" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="Catalogue" onAction="#goToCatalogue" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="Deconnexion" onAction="#goToLogin" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
        </HBox>

        <VBox spacing="8.0" style="-fx-background-color: linear-gradient(to right, #c114db, #8b5cf6, #7dd3fc); -fx-background-radius: 24; -fx-padding: 22 28 22 28;">
            <Label text="Stripe Checkout" style="-fx-font-size: 48px; -fx-font-weight: 800; -fx-text-fill: white;"/>
            <Label text="Paiement securise dans l'application" style="-fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.92);"/>
        </VBox>

        <HBox spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 22; -fx-border-color: #dbe2ea; -fx-border-radius: 22; -fx-padding: 0;">
            <children>
                <VBox spacing="14.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8fafc; -fx-background-radius: 22 0 0 22; -fx-padding: 20 22 20 22;">
                    <children>
                        <Label text="Resume commande" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>
                        <Label fx:id="infoLabel" text="Commande" style="-fx-text-fill: #475569;"/>
                        <Separator/>

                        <Label text="Adresse de livraison" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                        <TextArea fx:id="adresseArea"
                                  wrapText="true"
                                  prefRowCount="5"
                                  promptText="Rue, ville, code postal..."
                                  style="-fx-background-radius: 10; -fx-border-color: #d1d5db; -fx-border-radius: 10;"/>

                        <Separator/>
                        <Label fx:id="totalLabel" text="Total: 0.00" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
                    </children>
                </VBox>

                <VBox spacing="12.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 0 22 22 0; -fx-padding: 20 22 20 22;">
                    <children>
                        <Label text="Payer avec Stripe" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #111827;"/>

                        <Button text="Payer avec Link"
                                maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: #0ecb6b; -fx-text-fill: #03130a; -fx-font-size: 15px; -fx-font-weight: 700; -fx-background-radius: 8; -fx-cursor: hand;"/>

                        <HBox spacing="10.0" alignment="CENTER">
                            <Separator HBox.hgrow="ALWAYS"/>
                            <Label text="Ou" style="-fx-text-fill: #64748b;"/>
                            <Separator HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <Label text="Contact" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1f2937;"/>
                        <TextField promptText="you@example.com" style="-fx-background-radius: 8; -fx-border-color: #d1d5db; -fx-border-radius: 8;"/>

                        <Label text="Methode de paiement" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1f2937;"/>
                        <ComboBox fx:id="paiementCombo" prefWidth="260.0"/>

                        <Label text="Informations de livraison" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1f2937;"/>

                        <VBox fx:id="deliverySection" spacing="10.0" visible="false" managed="false">
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="Mode" style="-fx-text-fill: #334155;"/>
                                <ComboBox fx:id="livraisonModeCombo" prefWidth="220.0"/>
                            </HBox>

                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="Ville" style="-fx-text-fill: #334155;"/>
                                <TextField fx:id="villeField" prefWidth="220.0"/>
                            </HBox>

                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="Code postal" style="-fx-text-fill: #334155;"/>
                                <TextField fx:id="codePostalField" prefWidth="140.0"/>
                            </HBox>
                        </VBox>

                        <CheckBox text="J'accepte les conditions de paiement" selected="true" style="-fx-text-fill: #334155;"/>

                        <HBox spacing="10.0" style="-fx-padding: 6 0 0 0;">
                            <Button text="Annuler"
                                    onAction="#annuler"
                                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #0f172a; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button fx:id="confirmButton"
                                    text="Confirmer"
                                    onAction="#confirmerCommande"
                                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 0 4 0 4;">
            <Label text="Paiement securise par Stripe API" style="-fx-text-fill: #475569; -fx-font-size: 12px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Test card: 4242 4242 4242 4242" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>
    </children>
</VBox>

