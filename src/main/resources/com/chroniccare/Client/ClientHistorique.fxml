<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chroniccare.controllers.Client.ClientHistoriqueController"
      spacing="15"
      style="-fx-padding: 30; -fx-background-color: #f0f4ff;">

    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="historyTitle" text="📜 Mon Historique"
                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="utilisateurLabel" text="Client"
                   style="-fx-font-size: 12; -fx-text-fill: #666;"/>
            <Button text="🏠 Accueil"
                    onAction="#goToAccueil"
                    style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-size: 12; -fx-padding: 8 16; -fx-cursor: hand; -fx-background-radius: 8;"/>
            <Button text="🚪 Déconnexion"
                    onAction="#goToLogin"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 12; -fx-padding: 8 16; -fx-cursor: hand; -fx-background-radius: 8;"/>
        </HBox>

        <Separator/>

        <!-- Statistiques -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <VBox prefWidth="250" style="-fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 15; -fx-background-color: white;">
                <Label text="📋 Mes Commandes"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <Label fx:id="commandesCountLabel" text="0"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2563eb; -fx-padding: 8 0;"/>
            </VBox>

            <VBox prefWidth="250" style="-fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 15; -fx-background-color: white;">
                <Label text="🚚 Mes Livraisons"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <Label fx:id="livraisonsCountLabel" text="0"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #10b981; -fx-padding: 8 0;"/>
            </VBox>

            <VBox prefWidth="250" style="-fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 15; -fx-background-color: white;">
                <Label text="💰 Total Dépensé"
                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <Label fx:id="totalCALabel" text="0.00 €"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #f59e0b; -fx-padding: 8 0;"/>
            </VBox>
        </HBox>

        <Separator/>

        <!-- Tabs -->
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-font-size: 12;">
            <!-- Commandes Tab -->
            <Tab text="📋 Mes Commandes">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="Liste de toutes mes commandes"
                           style="-fx-font-size: 13; -fx-text-fill: #666;"/>
                    <TableView fx:id="commandesTable" prefHeight="400" style="-fx-font-size: 12;">
                        <columns>
                            <TableColumn fx:id="colCommandeId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colNumeroCommande" text="Numéro" prefWidth="160"/>
                            <TableColumn fx:id="colCommandeStatut" text="Statut" prefWidth="140"/>
                            <TableColumn fx:id="colTotal" text="Total" prefWidth="120"/>
                            <TableColumn fx:id="colDateCommande" text="Date" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Livraisons Tab -->
            <Tab text="🚚 Mes Livraisons">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="Suivi de toutes mes livraisons"
                           style="-fx-font-size: 13; -fx-text-fill: #666;"/>
                    <TableView fx:id="livraisonsTable" prefHeight="400" style="-fx-font-size: 12;">
                        <columns>
                            <TableColumn fx:id="colLivraisonId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colCommandeIdLiv" text="Commande" prefWidth="90"/>
                            <TableColumn fx:id="colLivraisonStatut" text="Statut" prefWidth="135"/>
                            <TableColumn fx:id="colAdresse" text="Adresse" prefWidth="200"/>
                            <TableColumn fx:id="colVille" text="Ville" prefWidth="100"/>
                            <TableColumn fx:id="colDatePrevue" text="Date prévue" prefWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>

    </children>
</VBox>

