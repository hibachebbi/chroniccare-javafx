<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.chroniccare.controllers.LoginController"
           style="-fx-background-color: #f1f5f9;">

    <!-- Background decoration -->
    <HBox style="-fx-background-color: #f1f5f9;" prefWidth="900" prefHeight="650">

        <!-- Left panel — blue -->
        <VBox prefWidth="420" prefHeight="650" alignment="CENTER" spacing="20"
              style="-fx-background-color: linear-gradient(to bottom, #1d4ed8, #2563eb, #3b82f6);
                     -fx-padding: 60 50;">

            <Label text="+"
                   style="-fx-font-size: 48; -fx-text-fill: white; -fx-font-weight: bold;
                          -fx-background-color: rgba(255,255,255,0.2);
                          -fx-background-radius: 20; -fx-padding: 10 20;"/>

            <Label text="ChronicCare"
                   style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Plateforme de suivi médical pour patients atteints de maladies chroniques."
                   style="-fx-font-size: 14; -fx-text-fill: rgba(255,255,255,0.85);
                          -fx-wrap-text: true; -fx-text-alignment: center;"
                   wrapText="true"/>

            <VBox spacing="14" style="-fx-padding: 30 0 0 0;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="ok"
                           style="-fx-background-color: rgba(255,255,255,0.25);
                                  -fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-background-radius: 50%; -fx-padding: 4 8;
                                  -fx-font-size: 11;"/>
                    <Label text="Suivi personnalisé de votre santé"
                           style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13;"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="ok"
                           style="-fx-background-color: rgba(255,255,255,0.25);
                                  -fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-background-radius: 50%; -fx-padding: 4 8;
                                  -fx-font-size: 11;"/>
                    <Label text="Conseils nutritionnels adaptes"
                           style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13;"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="ok"
                           style="-fx-background-color: rgba(255,255,255,0.25);
                                  -fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-background-radius: 50%; -fx-padding: 4 8;
                                  -fx-font-size: 11;"/>
                    <Label text="Coaching sportif specialise"
                           style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13;"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="ok"
                           style="-fx-background-color: rgba(255,255,255,0.25);
                                  -fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-background-radius: 50%; -fx-padding: 4 8;
                                  -fx-font-size: 11;"/>
                    <Label text="Equipe medicale disponible"
                           style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13;"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Right panel — form -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="0"
              style="-fx-background-color: white; -fx-padding: 60 50;">

            <!-- Header -->
            <VBox spacing="6" style="-fx-padding: 0 0 32 0;">
                <Label text="Bon retour !"
                       style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label text="Connectez-vous à votre espace santé"
                       style="-fx-font-size: 13; -fx-text-fill: #64748b;"/>
            </VBox>

            <!-- Email -->
            <VBox spacing="6" style="-fx-pref-width: 360; -fx-padding: 0 0 16 0;">
                <Label text="Adresse email"
                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <TextField fx:id="emailField"
                           promptText="exemple@email.com"
                           style="-fx-pref-height: 44; -fx-font-size: 13;
                                  -fx-background-radius: 10; -fx-border-radius: 10;
                                  -fx-border-color: #e2e8f0; -fx-border-width: 1.5;
                                  -fx-padding: 0 14; -fx-background-color: #f8fafc;"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="6" style="-fx-pref-width: 360; -fx-padding: 0 0 8 0;">
                <Label text="Mot de passe"
                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <PasswordField fx:id="passwordField"
                               promptText="Votre mot de passe"
                               style="-fx-pref-height: 44; -fx-font-size: 13;
                                      -fx-background-radius: 10; -fx-border-radius: 10;
                                      -fx-border-color: #e2e8f0; -fx-border-width: 1.5;
                                      -fx-padding: 0 14; -fx-background-color: #f8fafc;"/>
            </VBox>

            <HBox alignment="CENTER_RIGHT" style="-fx-pref-width: 360; -fx-padding: 0 0 8 0;">
                <Hyperlink text="Mot de passe oublié ?"
                           onAction="#goToForgotPassword"
                           style="-fx-font-size: 12; -fx-text-fill: #2563eb;
                                  -fx-font-weight: bold; -fx-border-width: 0;"/>
            </HBox>

            <!-- Error -->
            <Label fx:id="errorLabel"
                   style="-fx-text-fill: #dc2626; -fx-font-size: 12;
                          -fx-pref-width: 360; -fx-padding: 4 0 8 0;"/>

            <!-- Login button -->
            <Button text="Se connecter"
                    onAction="#handleLogin"
                    style="-fx-pref-width: 360; -fx-pref-height: 46;
                           -fx-background-color: #2563eb; -fx-text-fill: white;
                           -fx-font-size: 14; -fx-font-weight: bold;
                           -fx-cursor: hand; -fx-background-radius: 10;
                           -fx-border-width: 0;"/>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 20 0;">
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="ou" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>

            <Button text="Continuer avec Google"
                    onAction="#handleGoogleLogin"
                    style="-fx-pref-width: 360; -fx-pref-height: 44;
                           -fx-background-color: white; -fx-text-fill: #0f172a;
                           -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-cursor: hand; -fx-background-radius: 10;
                           -fx-border-color: #cbd5e1; -fx-border-radius: 10;
                           -fx-border-width: 1.2;"/>

            <!-- Register link -->
            <VBox alignment="CENTER" spacing="4">
                <Label text="Pas encore de compte ?"
                       style="-fx-font-size: 13; -fx-text-fill: #64748b;"/>
                <Hyperlink text="Créer un compte gratuitement"
                           onAction="#goToRegister"
                           style="-fx-font-size: 13; -fx-text-fill: #2563eb;
                                  -fx-font-weight: bold; -fx-border-width: 0;"/>
            </VBox>

            <!-- Footer -->
            <Label text="ChronicCare - Votre santé, notre priorité"
                   style="-fx-font-size: 11; -fx-text-fill: #cbd5e1;
                          -fx-padding: 40 0 0 0;"/>

        </VBox>
    </HBox>

</StackPane>
