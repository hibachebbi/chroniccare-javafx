<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chroniccare.controllers.ProfilePatientController"
      styleClass="dashboard-body" spacing="20"
      stylesheets="@home-styles.css">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Patient" styleClass="admin-badge" style="-fx-background-color: #1d4ed8;"/>
                <Label fx:id="statusBadge" styleClass="admin-badge"/>
            </HBox>

            <HBox spacing="20">
                <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS">
                    <Label text="Informations personnelles" styleClass="card-title"/>
                    <Separator/>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Nom" styleClass="info-label"/>
                            <TextField fx:id="nomField" promptText="Votre nom"
                                       style="-fx-pref-height: 38; -fx-font-size: 13; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1.5;"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Prenom" styleClass="info-label"/>
                            <TextField fx:id="prenomField" promptText="Votre prenom"
                                       style="-fx-pref-height: 38; -fx-font-size: 13; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1.5;"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="6">
                        <Label text="Email" styleClass="info-label"/>
                        <TextField fx:id="emailField" promptText="Votre email"
                                   style="-fx-pref-height: 38; -fx-font-size: 13; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1.5;"/>
                    </VBox>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Telephone" styleClass="info-label"/>
                            <TextField fx:id="telephoneField" promptText="8 chiffres"
                                       style="-fx-pref-height: 38; -fx-font-size: 13; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1.5;"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Genre" styleClass="info-label"/>
                            <ComboBox fx:id="genreCombo" maxWidth="Infinity" style="-fx-pref-height: 38; -fx-font-size: 13;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="card, card-tips" spacing="16" prefWidth="300">
                    <Label text="Informations medicales" styleClass="card-title"/>
                    <Separator/>
                    <VBox spacing="6">
                        <Label text="Condition medicale" styleClass="info-label"/>
                        <TextField fx:id="medicalField" promptText="Ex: hypertension, diabete..."
                                   style="-fx-pref-height: 38; -fx-font-size: 13; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #fde68a; -fx-border-width: 1.5;"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Conseil" styleClass="tip-title"/>
                        <Label text="Maintenir vos informations medicales a jour permet a votre equipe soignante de mieux vous accompagner."
                               styleClass="tip-text" wrapText="true"/>
                    </VBox>
                </VBox>
            </HBox>

            <VBox styleClass="card" spacing="16">
                <Label text="Dossier medical intelligent" styleClass="card-title"/>
                <Separator/>
                <HBox spacing="12">
                    <VBox styleClass="stat-card, stat-blue" spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Condition principale" styleClass="stat-label"/>
                        <Label fx:id="summaryMainConditionLabel" text="-" styleClass="stat-value-sm"/>
                        <Label text="Maladie principale du dossier" styleClass="stat-sub"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-green" spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Maladies secondaires" styleClass="stat-label"/>
                        <Label fx:id="summarySecondaryCountLabel" text="0" styleClass="stat-value-sm"/>
                        <Label text="Comorbidites ajoutees" styleClass="stat-sub"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-purple" spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Questionnaire" styleClass="stat-label"/>
                        <Label fx:id="summaryQuestionnaireLabel" text="Non charge" styleClass="stat-value-sm"/>
                        <Label text="Etat des reponses medicales" styleClass="stat-sub"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-orange" spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Dossier IA / PDF" styleClass="stat-label"/>
                        <Label fx:id="summaryRecordLabel" text="Vide" styleClass="stat-value-sm"/>
                        <Label fx:id="summaryPdfLabel" text="PDF non importe" styleClass="stat-sub"/>
                    </VBox>
                </HBox>
                <VBox spacing="10">
                    <Label text="Questionnaire selon la maladie" styleClass="info-label"/>
                    <HBox spacing="10">
                        <Button text="Charger questionnaire" onAction="#loadQuestionnaire" styleClass="btn-primary"/>
                        <Button text="Generer dossier IA" onAction="#handleGenerateAI" styleClass="btn-primary"/>
                    </HBox>
                    <Label fx:id="recordActionStatusLabel" wrapText="true" managed="false" visible="false"/>
                </VBox>
                <VBox fx:id="questionnaireBox" spacing="10" visible="false" managed="false"/>
                <Separator/>
                <VBox spacing="10">
                    <Label text="Dossier medical" styleClass="info-label"/>
                    <TabPane fx:id="recordTabs" prefHeight="260" styleClass="record-tabs"
                             style="-fx-background-color: transparent;">
                        <tabs>
                            <Tab text="Apercu" closable="false">
                                <content>
                                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                                        <VBox fx:id="recordPreviewBox" spacing="10" style="-fx-padding: 8;"/>
                                    </ScrollPane>
                                </content>
                            </Tab>
                            <Tab text="Edition" closable="false">
                                <content>
                                    <TextArea fx:id="aiResultArea" prefHeight="220" wrapText="true"
                                              promptText="Le dossier medical genere par IA apparaitra ici..."/>
                                </content>
                            </Tab>
                        </tabs>
                    </TabPane>
                </VBox>
                <HBox spacing="10">
                    <Button text="Importer PDF" onAction="#handleImportPdf" styleClass="btn-primary"/>
                    <Button text="Exporter PDF" onAction="#handleExportPdf" styleClass="btn-primary"/>
                </HBox>
                <Separator/>
                <VBox spacing="10">
                    <Label text="Ajouter une maladie secondaire" styleClass="info-label"/>
                    <HBox spacing="10">
                        <TextField fx:id="newConditionField" promptText="Nouvelle maladie" HBox.hgrow="ALWAYS"/>
                        <Button text="Ajouter maladie" onAction="#handleAddCondition" styleClass="btn-primary"/>
                    </HBox>
                </VBox>
                <VBox spacing="10">
                    <Label text="Maladies secondaires" styleClass="info-label"/>
                    <VBox fx:id="secondaryConditionsBox" spacing="8"/>
                </VBox>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
            <Label fx:id="successLabel" styleClass="success-label" wrapText="true"/>
            <Button text="Enregistrer les modifications" styleClass="btn-primary"
                    onAction="#handleSave" style="-fx-pref-height: 44; -fx-font-size: 14; -fx-pref-width: 300;"/>
</VBox>
