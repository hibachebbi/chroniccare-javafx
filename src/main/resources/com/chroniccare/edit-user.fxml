<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chroniccare.controllers.user.EditUserController"
      alignment="CENTER"
      spacing="12"
      style="-fx-padding: 40; -fx-background-color: #f0f4ff;">

    <Label text="Modifier un utilisateur"
           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>

    <VBox spacing="5" style="-fx-pref-width: 350;">
        <Label text="Nom" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        <TextField fx:id="nomField"
                   promptText="Entrez le nom"
                   style="-fx-pref-height: 38; -fx-font-size: 13;"/>
    </VBox>

    <VBox spacing="5" style="-fx-pref-width: 350;">
        <Label text="Prénom" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        <TextField fx:id="prenomField"
                   promptText="Entrez le prénom"
                   style="-fx-pref-height: 38; -fx-font-size: 13;"/>
    </VBox>

    <VBox spacing="5" style="-fx-pref-width: 350;">
        <Label text="Email" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        <TextField fx:id="emailField"
                   promptText="Entrez l'email"
                   style="-fx-pref-height: 38; -fx-font-size: 13;"/>
    </VBox>

    <VBox spacing="5" style="-fx-pref-width: 350;">
        <Label text="Téléphone" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        <TextField fx:id="telephoneField"
                   promptText="8 chiffres"
                   style="-fx-pref-height: 38; -fx-font-size: 13;"/>
    </VBox>

    <VBox spacing="5" style="-fx-pref-width: 350;">
        <Label text="Genre" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        <ComboBox fx:id="genreCombo"
                  promptText="Choisir le genre"
                  style="-fx-pref-width: 350; -fx-pref-height: 38;"/>
    </VBox>

    <VBox spacing="5" style="-fx-pref-width: 350;">
        <Label text="Rôle" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        <ComboBox fx:id="rolesCombo"
                  promptText="Choisir un rôle"
                  style="-fx-pref-width: 350; -fx-pref-height: 38;"/>
    </VBox>

    <VBox spacing="5" style="-fx-pref-width: 350;">
        <Label text="Statut" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        <ComboBox fx:id="statusCombo"
                  promptText="Choisir le statut"
                  style="-fx-pref-width: 350; -fx-pref-height: 38;"/>
    </VBox>

    <VBox spacing="5" style="-fx-pref-width: 350;">
        <Label text="Condition médicale" style="-fx-font-size: 13; -fx-font-weight: bold;"/>
        <TextField fx:id="medicalField"
                   promptText="Ex: hypertension, diabète..."
                   style="-fx-pref-height: 38; -fx-font-size: 13;"/>
    </VBox>

    <Label fx:id="errorLabel"
           style="-fx-text-fill: red; -fx-font-size: 12;"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Annuler"
                onAction="#goToList"
                style="-fx-pref-width: 165; -fx-pref-height: 42;
                       -fx-background-color: #6b7280; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-font-weight: bold;
                       -fx-cursor: hand; -fx-background-radius: 8;"/>
        <Button text="Enregistrer"
                onAction="#handleEdit"
                style="-fx-pref-width: 165; -fx-pref-height: 42;
                       -fx-background-color: #2563eb; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-font-weight: bold;
                       -fx-cursor: hand; -fx-background-radius: 8;"/>
    </HBox>

</VBox>