<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.chroniccare.controllers.RegisterController"
           style="-fx-background-color: #f1f5f9;">

    <HBox style="-fx-background-color: #f1f5f9;" prefWidth="1000" prefHeight="700">

        <!-- Left panel — blue -->
        <VBox prefWidth="380" prefHeight="700" alignment="CENTER" spacing="18"
              style="-fx-background-color: linear-gradient(to bottom, #1d4ed8, #2563eb, #3b82f6);
                     -fx-padding: 60 40;">

            <Label text="+"
                   style="-fx-font-size: 42; -fx-text-fill: white; -fx-font-weight: bold;
                          -fx-background-color: rgba(255,255,255,0.2);
                          -fx-background-radius: 16; -fx-padding: 8 18;"/>

            <Label text="ChronicCare"
                   style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Rejoignez notre communauté et prenez le contrôle de votre santé au quotidien."
                   style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.85);
                          -fx-wrap-text: true; -fx-text-alignment: center;"
                   wrapText="true"/>

            <Separator style="-fx-background-color: rgba(255,255,255,0.2); -fx-padding: 8 0;"/>

            <VBox spacing="14">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="P"
                           style="-fx-background-color: rgba(255,255,255,0.25);
                                  -fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-background-radius: 50%; -fx-padding: 4 9;
                                  -fx-font-size: 11;"/>
                    <VBox spacing="2">
                        <Label text="Patient"
                               style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;"/>
                        <Label text="Suivi médical personnalisé"
                               style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 11;"/>
                    </VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="C"
                           style="-fx-background-color: rgba(255,255,255,0.25);
                                  -fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-background-radius: 50%; -fx-padding: 4 9;
                                  -fx-font-size: 11;"/>
                    <VBox spacing="2">
                        <Label text="Coach"
                               style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;"/>
                        <Label text="Accompagnement sportif specialise"
                               style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 11;"/>
                    </VBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="N"
                           style="-fx-background-color: rgba(255,255,255,0.25);
                                  -fx-text-fill: white; -fx-font-weight: bold;
                                  -fx-background-radius: 50%; -fx-padding: 4 9;
                                  -fx-font-size: 11;"/>
                    <VBox spacing="2">
                        <Label text="Nutritionniste"
                               style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;"/>
                        <Label text="Plans alimentaires adaptes"
                               style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 11;"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>

        <!-- Right panel — form -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="0"
              style="-fx-background-color: white; -fx-padding: 40 50;">

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="0" alignment="CENTER"
                      style="-fx-background-color: white; -fx-padding: 10 0;">

                    <!-- Header -->
                    <VBox spacing="4" style="-fx-padding: 0 0 24 0;">
                        <Label text="Créer un compte"
                               style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        <Label text="Remplissez le formulaire pour rejoindre ChronicCare"
                               style="-fx-font-size: 12; -fx-text-fill: #64748b;"/>
                    </VBox>

                    <!-- Nom + Prenom -->
                    <HBox spacing="12" style="-fx-pref-width: 400; -fx-padding: 0 0 14 0;">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Nom"
                                   style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <TextField fx:id="nomField" promptText="Votre nom"
                                       style="-fx-pref-height: 40; -fx-font-size: 13;
                                              -fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #e2e8f0; -fx-border-width: 1.5;
                                              -fx-background-color: #f8fafc; -fx-padding: 0 12;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Prénom"
                                   style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <TextField fx:id="prenomField" promptText="Votre prenom"
                                       style="-fx-pref-height: 40; -fx-font-size: 13;
                                              -fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #e2e8f0; -fx-border-width: 1.5;
                                              -fx-background-color: #f8fafc; -fx-padding: 0 12;"/>
                        </VBox>
                    </HBox>

                    <!-- Email -->
                    <VBox spacing="5" style="-fx-pref-width: 400; -fx-padding: 0 0 14 0;">
                        <Label text="Adresse email"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <TextField fx:id="emailField" promptText="exemple@email.com"
                                   style="-fx-pref-height: 40; -fx-font-size: 13;
                                          -fx-background-radius: 8; -fx-border-radius: 8;
                                          -fx-border-color: #e2e8f0; -fx-border-width: 1.5;
                                          -fx-background-color: #f8fafc; -fx-padding: 0 12;"/>
                    </VBox>

                    <!-- Password -->
                    <VBox spacing="5" style="-fx-pref-width: 400; -fx-padding: 0 0 14 0;">
                        <Label text="Mot de passe"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <PasswordField fx:id="passwordField" promptText="Minimum 8 caracteres"
                                       style="-fx-pref-height: 40; -fx-font-size: 13;
                                              -fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #e2e8f0; -fx-border-width: 1.5;
                                              -fx-background-color: #f8fafc; -fx-padding: 0 12;"/>
                    </VBox>

                    <!-- Telephone + Genre -->
                    <HBox spacing="12" style="-fx-pref-width: 400; -fx-padding: 0 0 14 0;">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Téléphone"
                                   style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <TextField fx:id="telephoneField" promptText="8 chiffres"
                                       style="-fx-pref-height: 40; -fx-font-size: 13;
                                              -fx-background-radius: 8; -fx-border-radius: 8;
                                              -fx-border-color: #e2e8f0; -fx-border-width: 1.5;
                                              -fx-background-color: #f8fafc; -fx-padding: 0 12;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Genre"
                                   style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <ComboBox fx:id="genreCombo" promptText="Choisir"
                                      maxWidth="Infinity"
                                      style="-fx-pref-height: 40; -fx-font-size: 13;
                                             -fx-background-radius: 8; -fx-border-radius: 8;
                                             -fx-border-color: #e2e8f0;"/>
                        </VBox>
                    </HBox>

                    <!-- Role -->
                    <VBox spacing="5" style="-fx-pref-width: 400; -fx-padding: 0 0 8 0;">
                        <Label text="Je suis un(e)"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <ComboBox fx:id="rolesCombo" promptText="Choisir votre role"
                                  maxWidth="Infinity"
                                  style="-fx-pref-width: 400; -fx-pref-height: 40; -fx-font-size: 13;
                                         -fx-background-radius: 8; -fx-border-radius: 8;
                                         -fx-border-color: #e2e8f0;"/>
                    </VBox>

                    <!-- Error -->
                    <Label fx:id="errorLabel"
                           style="-fx-text-fill: #dc2626; -fx-font-size: 12;
                                  -fx-pref-width: 400; -fx-padding: 4 0 8 0;"/>

                    <!-- Register button -->
                    <Button text="Créer mon compte"
                            onAction="#handleRegister"
                            style="-fx-pref-width: 400; -fx-pref-height: 44;
                                   -fx-background-color: #2563eb; -fx-text-fill: white;
                                   -fx-font-size: 14; -fx-font-weight: bold;
                                   -fx-cursor: hand; -fx-background-radius: 10;
                                   -fx-border-width: 0;"/>

                    <!-- Login link -->
                    <HBox alignment="CENTER" spacing="4" style="-fx-padding: 16 0 0 0;">
                        <Label text="Deja un compte ?"
                               style="-fx-font-size: 13; -fx-text-fill: #64748b;"/>
                        <Hyperlink text="Se connecter"
                                   onAction="#goToLogin"
                                   style="-fx-font-size: 13; -fx-text-fill: #2563eb;
                                          -fx-font-weight: bold; -fx-border-width: 0;"/>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>

</StackPane>
