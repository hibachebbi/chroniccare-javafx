<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.chroniccare.controllers.EditExerciseController"
            prefWidth="1180" prefHeight="760"
            stylesheets="@home-styles.css">

    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="+" styleClass="brand-icon"/>
                    <Label text="ChronicCare" styleClass="brand-title"/>
                </HBox>
                <Label text="Suivi medical intelligent" styleClass="brand-subtitle"/>
            </VBox>
            <VBox styleClass="sidebar-user-card" spacing="6">
                <Label fx:id="sidebarAvatar" styleClass="sidebar-avatar"/>
                <Label fx:id="sidebarUserName" styleClass="sidebar-user-name"/>
                <Label text="Coach" styleClass="sidebar-role-badge"
                       style="-fx-text-fill: #4ade80; -fx-background-color: #14532d;"/>
            </VBox>
            <Separator styleClass="sidebar-sep"/>
            <VBox styleClass="nav-section" spacing="2" VBox.vgrow="ALWAYS">
                <Label text="NAVIGATION" styleClass="nav-section-label"/>
                <Button text="Événements" styleClass="nav-btn" onAction="#goToEvents" maxWidth="Infinity"/>
                <Button text="Exercices" styleClass="nav-btn, nav-btn-active" onAction="#goToList" maxWidth="Infinity"/>
                <Button text="Mon profil" styleClass="nav-btn" onAction="#goToProfile" maxWidth="Infinity"/>
            </VBox>
            <VBox styleClass="sidebar-bottom">
                <Separator styleClass="sidebar-sep"/>
                <Button text="Déconnexion" styleClass="nav-btn, nav-btn-logout"
                        onAction="#handleLogout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content" spacing="0">
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <Label text="Modifier un exercice" styleClass="page-title, exercise-form-page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="topbarDate" styleClass="topbar-date"/>
                <HBox styleClass="topbar-user-pill" alignment="CENTER" spacing="8">
                    <Label fx:id="topbarAvatar" styleClass="topbar-avatar"/>
                    <Label fx:id="topbarUserName" styleClass="topbar-username"/>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll">
                <VBox spacing="20" styleClass="dashboard-body">
                    <HBox styleClass="welcome-banner" alignment="CENTER_LEFT" spacing="18">
                        <VBox spacing="8">
                            <Label text="Ajuste ton exercice en precision" styleClass="welcome-title"/>
                            <Label text="Mets a jour les paramètres pour garder des séances cohérentes et progressives."
                                   styleClass="welcome-subtitle" wrapText="true"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Mise à jour" styleClass="status-chip, status-chip-pending"/>
                    </HBox>

                    <VBox styleClass="card, exercise-form-card" spacing="18">
                        <Label text="Ajuste les details de l'exercice" styleClass="card-title"/>
                        <GridPane hgap="16" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Nom" styleClass="info-label"/>
                                <TextField fx:id="nomField" styleClass="filter-field"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Événement" styleClass="info-label"/>
                                <ComboBox fx:id="eventCombo" maxWidth="Infinity" styleClass="filter-combo"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Duree (minutes)" styleClass="info-label"/>
                                <TextField fx:id="dureeField" styleClass="filter-field"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Repetitions" styleClass="info-label"/>
                                <TextField fx:id="repetitionsField" styleClass="filter-field"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                                <Label text="Description" styleClass="info-label"/>
                                <TextArea fx:id="descriptionArea" prefRowCount="6" wrapText="true"/>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Button fx:id="suggestDescriptionButton" text="Suggérer via IA" styleClass="btn-ai"
                                            onAction="#handleSuggestDescription"/>
                                    <Label fx:id="aiSuggestionLabel" styleClass="ai-helper-label" wrapText="true"
                                           text="L'IA peut proposer une nouvelle description."/>
                                </HBox>
                            </VBox>
                        </GridPane>

                        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false"/>

                        <HBox spacing="10">
                            <Button text="Annuler" styleClass="btn-secondary" onAction="#goToList"/>
                            <Button text="Enregistrer" styleClass="btn-primary" onAction="#handleSave"/>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
