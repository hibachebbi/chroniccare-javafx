<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.chroniccare.controllers.ForgotPasswordController"
           style="-fx-background-color: #f1f5f9;">

    <HBox style="-fx-background-color: #f1f5f9;" prefWidth="900" prefHeight="650">

        <!-- Left panel — blue -->
        <VBox prefWidth="420" prefHeight="650" alignment="CENTER" spacing="20"
              style="-fx-background-color: linear-gradient(to bottom, #1d4ed8, #2563eb, #3b82f6);
                     -fx-padding: 60 50;">

            <Label text="+"
                   style="-fx-font-size: 48; -fx-text-fill: white; -fx-font-weight: bold;
                          -fx-background-color: rgba(255,255,255,0.2);
                          -fx-background-radius: 20; -fx-padding: 10 20;"/>

            <Label text="ChronicCare"
                   style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label text="Récupérez l'accès à votre compte en toute sécurité."
                   style="-fx-font-size: 14; -fx-text-fill: rgba(255,255,255,0.85);
                          -fx-wrap-text: true; -fx-text-alignment: center;"
                   wrapText="true"/>
        </VBox>

        <!-- Right panel — form -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="0"
              style="-fx-background-color: white; -fx-padding: 60 50;">

            <!-- Header -->
            <VBox spacing="6" style="-fx-padding: 0 0 26 0;">
                <Label text="Mot de passe oublié"
                       style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Label text="Entrez votre email. Nous vous envoyons un lien et un code."
                       style="-fx-font-size: 13; -fx-text-fill: #64748b;"/>
            </VBox>

            <!-- Email -->
            <VBox spacing="6" style="-fx-pref-width: 360; -fx-padding: 0 0 12 0;">
                <Label text="Adresse email"
                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <TextField fx:id="emailField"
                           promptText="exemple@email.com"
                           style="-fx-pref-height: 44; -fx-font-size: 13;
                                  -fx-background-radius: 10; -fx-border-radius: 10;
                                  -fx-border-color: #e2e8f0; -fx-border-width: 1.5;
                                  -fx-padding: 0 14; -fx-background-color: #f8fafc;"/>
            </VBox>

            <Button text="Envoyer le lien"
                    onAction="#handleSendResetLink"
                    style="-fx-pref-width: 360; -fx-pref-height: 44;
                           -fx-background-color: #2563eb; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-cursor: hand; -fx-background-radius: 10;
                           -fx-border-width: 0;"/>

            <Label fx:id="infoLabel"
                   wrapText="true"
                   style="-fx-text-fill: #16a34a; -fx-font-size: 12;
                          -fx-pref-width: 360; -fx-padding: 10 0 0 0;"/>

            <Label fx:id="errorLabel"
                   wrapText="true"
                   style="-fx-text-fill: #dc2626; -fx-font-size: 12;
                          -fx-pref-width: 360; -fx-padding: 6 0 0 0;"/>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 22 0 18 0;">
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="Puis"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Reset using code -->
            <VBox spacing="10" style="-fx-pref-width: 360;">

                <VBox spacing="6">
                    <Label text="Code de récupération"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <TextField fx:id="tokenField"
                               promptText="Collez le code reçu par email"
                               style="-fx-pref-height: 44; -fx-font-size: 13;
                                      -fx-background-radius: 10; -fx-border-radius: 10;
                                      -fx-border-color: #e2e8f0; -fx-border-width: 1.5;
                                      -fx-padding: 0 14; -fx-background-color: #f8fafc;"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Nouveau mot de passe"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <PasswordField fx:id="newPasswordField"
                                   promptText="Minimum 8 caractères"
                                   style="-fx-pref-height: 44; -fx-font-size: 13;
                                          -fx-background-radius: 10; -fx-border-radius: 10;
                                          -fx-border-color: #e2e8f0; -fx-border-width: 1.5;
                                          -fx-padding: 0 14; -fx-background-color: #f8fafc;"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Confirmer le mot de passe"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Répétez le mot de passe"
                                   style="-fx-pref-height: 44; -fx-font-size: 13;
                                          -fx-background-radius: 10; -fx-border-radius: 10;
                                          -fx-border-color: #e2e8f0; -fx-border-width: 1.5;
                                          -fx-padding: 0 14; -fx-background-color: #f8fafc;"/>
                </VBox>

                <Button text="Réinitialiser le mot de passe"
                        onAction="#handleResetPassword"
                        style="-fx-pref-width: 360; -fx-pref-height: 44;
                               -fx-background-color: #0f172a; -fx-text-fill: white;
                               -fx-font-size: 13; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-background-radius: 10;
                               -fx-border-width: 0;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="6" style="-fx-padding: 20 0 0 0;">
                <Hyperlink text="Retour à la connexion"
                           onAction="#goToLogin"
                           style="-fx-font-size: 13; -fx-text-fill: #2563eb;
                                  -fx-font-weight: bold; -fx-border-width: 0;"/>
            </VBox>

        </VBox>
    </HBox>

</StackPane>
