<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.chroniccare.controllers.ListUsersController"
            stylesheets="@home-styles.css">

    <!-- SIDEBAR (copié de home.fxml) -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="230" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="✚" styleClass="brand-icon"/>
                    <Label text="ChronicCare" styleClass="brand-title"/>
                </HBox>
                <Label text="Suivi médical intelligent" styleClass="brand-subtitle"/>
            </VBox>

            <VBox styleClass="sidebar-user-card" spacing="6">
                <Label fx:id="sidebarAvatar" styleClass="sidebar-avatar"/>
                <Label fx:id="sidebarUserName" styleClass="sidebar-user-name"/>
                <Label fx:id="sidebarRoleBadge" styleClass="sidebar-role-badge"/>
            </VBox>

            <Separator styleClass="sidebar-sep"/>

            <VBox styleClass="nav-section" spacing="2" VBox.vgrow="ALWAYS">
                <Label text="NAVIGATION" styleClass="nav-section-label"/>

                <Button text="🏠  Accueil"
                        styleClass="nav-btn"
                        onAction="#goToHome"
                        maxWidth="Infinity"/>

                <Button text="👤  Mon Profil"
                        styleClass="nav-btn"
                        onAction="#goToProfile"
                        maxWidth="Infinity"/>

                <Button text="👥  Gestion Utilisateurs"
                        styleClass="nav-btn, nav-btn-active"
                        maxWidth="Infinity"/>

                <Label text="MES SOINS" styleClass="nav-section-label"/>

                <Button text="📋  Mon Suivi" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button text="🥗  Nutrition" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button text="🏃  Activité Physique" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button text="💊  Médicaments" styleClass="nav-btn" maxWidth="Infinity"/>
                <Button text="🔒 Comptes bloqués"
                        styleClass="nav-btn"
                        onAction="#goToBlockedAccounts"
                        maxWidth="Infinity"/>
                <Button text="📝  Audit médical"
                        styleClass="nav-btn"
                        onAction="#goToMedicalAudit"
                        maxWidth="Infinity"/>
                <Button text="🧩  Segmentation patients"
                        styleClass="nav-btn"
                        onAction="#goToPatientSegmentation"
                        maxWidth="Infinity"/>
                <Button text="📊  Statistiques"
                        styleClass="nav-btn"
                        onAction="#goToStats"
                        maxWidth="Infinity"/>
            </VBox>

            <VBox styleClass="sidebar-bottom">
                <Separator styleClass="sidebar-sep"/>
                <Button text="⏻  Déconnexion"
                        styleClass="nav-btn, nav-btn-logout"
                        onAction="#handleLogout"
                        maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENU -->
    <center>
        <VBox styleClass="main-content">

            <!-- TOPBAR -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <Label text="Gestion des utilisateurs" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="topbarDate" styleClass="topbar-date"/>
                <HBox styleClass="topbar-user-pill" alignment="CENTER" spacing="8">
                    <Label fx:id="topbarAvatar" styleClass="topbar-avatar"/>
                    <Label fx:id="topbarUserName" styleClass="topbar-username"/>
                </HBox>
            </HBox>

            <!-- CONTENU PRINCIPAL -->
            <VBox styleClass="dashboard-body" spacing="20">

                <!-- CARTE -->
                <VBox styleClass="card" spacing="15">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Liste des utilisateurs" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Ajouter"
                                styleClass="btn-primary"
                                onAction="#goToAdd"/>
                    </HBox>

                    <!-- RECHERCHE -->
                    <HBox spacing="10">
                        <TextField fx:id="searchField"
                                   promptText="Rechercher..."
                                   HBox.hgrow="ALWAYS"/>

                        <ComboBox fx:id="roleFilter"/>

                        <Button text="Rechercher"
                                styleClass="btn-primary"
                                onAction="#handleSearch"/>

                        <Button text="Réinitialiser"
                                styleClass="btn-secondary"
                                onAction="#handleReset"/>
                    </HBox>

                    <!-- TABLE -->
                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">

                        <columns>
                            <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="nomCol" text="Nom" prefWidth="120"/>
                            <TableColumn fx:id="prenomCol" text="Prénom" prefWidth="120"/>
                            <TableColumn fx:id="emailCol" text="Email" prefWidth="220"/>
                            <TableColumn fx:id="rolesCol" text="Rôle" prefWidth="150"/>
                            <TableColumn fx:id="genreCol" text="Genre" prefWidth="100"/>
                            <TableColumn fx:id="statusCol" text="Statut" prefWidth="120"/>
                            <TableColumn fx:id="actionsCol" text="Actions" prefWidth="200"/>
                        </columns>

                    </TableView>

                    <!-- FOOTER -->
                    <HBox alignment="CENTER">
                        <Button text="◀" onAction="#previousPage" styleClass="btn-secondary"/>
                        <Label fx:id="pageLabel"/>
                        <Button text="▶" onAction="#nextPage" styleClass="btn-secondary"/>
                    </HBox>

                    <Label fx:id="countLabel"/>

                </VBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
