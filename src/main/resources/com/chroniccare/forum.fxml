<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.chroniccare.controllers.ForumController"
            prefWidth="1100" prefHeight="700"
            stylesheets="@styles.css, @home-styles.css">

    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="✚" styleClass="brand-icon"/>
                    <Label text="ChronicCare" styleClass="brand-title"/>
                </HBox>
                <Label text="Suivi médical intelligent" styleClass="brand-subtitle"/>
            </VBox>
            <VBox styleClass="sidebar-user-card" spacing="6">
                <Label fx:id="sidebarAvatar"   styleClass="sidebar-avatar"/>
                <Label fx:id="sidebarUserName" styleClass="sidebar-user-name"/>
                <Label fx:id="sidebarRoleBadge" styleClass="sidebar-role-badge"/>
            </VBox>
            <Separator styleClass="sidebar-sep"/>
            <VBox styleClass="nav-section" spacing="2" VBox.vgrow="ALWAYS">
                <Label text="NAVIGATION" styleClass="nav-section-label"/>
                <Button text="🏠  Accueil"    styleClass="nav-btn" maxWidth="Infinity"/>
                <Label text="FORUM" styleClass="nav-section-label"/>
                <Button text="📢  Publications"
                        styleClass="nav-btn, nav-btn-active" maxWidth="Infinity"/>
                <Label text="MES SOINS" styleClass="nav-section-label"/>
                <Button text="📋  Mon Suivi"  styleClass="nav-btn" maxWidth="Infinity"/>
                <Button text="🥗  Nutrition"  styleClass="nav-btn" maxWidth="Infinity"/>
                <Button text="💊  Médicaments" styleClass="nav-btn" maxWidth="Infinity"/>
            </VBox>
            <VBox styleClass="sidebar-bottom">
                <Separator styleClass="sidebar-sep"/>
                <Button text="⏻  Déconnexion"
                        styleClass="nav-btn, nav-btn-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content" spacing="0">

            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <Label text="Forum" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAjouter" text="+ Nouvelle publication"
                        styleClass="btn-primary" onAction="#ouvrirAjout"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll">
                <VBox spacing="20" styleClass="dashboard-body">

                    <HBox styleClass="welcome-banner" spacing="20" alignment="CENTER_LEFT">
                        <VBox spacing="8">
                            <Label text="Forum ChronicCare" styleClass="welcome-title"/>
                            <Label text="Partagez vos expériences avec la communauté"
                                   styleClass="welcome-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="💬" styleClass="banner-emoji"/>
                    </HBox>

                    <HBox spacing="16">
                        <VBox styleClass="stat-card, stat-blue" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="📢" styleClass="stat-icon"/>
                            <Label text="Publications" styleClass="stat-label"/>
                            <Label fx:id="statPublications" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-card, stat-green" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="💬" styleClass="stat-icon"/>
                            <Label text="Commentaires" styleClass="stat-label"/>
                            <Label fx:id="statCommentaires" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-card, stat-purple" spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="❤️" styleClass="stat-icon"/>
                            <Label text="Total likes" styleClass="stat-label"/>
                            <Label fx:id="statLikes" text="0" styleClass="stat-value"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="card" spacing="16">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📋" styleClass="card-icon"/>
                            <Label text="Toutes les publications" styleClass="card-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="filtreCategorie"
                                      promptText="Filtrer par catégorie"
                                      onAction="#filtrer" prefWidth="180"/>
                        </HBox>
                        <Separator/>
                        <TableView fx:id="tablePublications"
                                   VBox.vgrow="ALWAYS" prefHeight="350">
                            <columns>
                                <TableColumn fx:id="colTitre"     text="Titre"     prefWidth="200"/>
                                <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="110"/>
                                <TableColumn fx:id="colStatut"    text="Statut"    prefWidth="90"/>
                                <TableColumn fx:id="colLikes"     text="❤️"        prefWidth="60"/>
                                <TableColumn fx:id="colVues"      text="👁"         prefWidth="60"/>
                                <TableColumn fx:id="colDate"      text="Date"      prefWidth="130"/>
                                <TableColumn fx:id="colActions"   text="Actions"   prefWidth="160"/>
                            </columns>
                            <placeholder>
                                <Label text="Aucune publication."
                                       style="-fx-text-fill: #94a3b8; -fx-font-size:14px;"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>