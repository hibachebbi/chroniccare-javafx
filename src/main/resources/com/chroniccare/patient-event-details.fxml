<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.chroniccare.controllers.PatientEventDetailsController"
            fitToWidth="true" styleClass="content-scroll"
            stylesheets="@home-styles.css">

    <VBox spacing="20" styleClass="dashboard-body">
        <HBox styleClass="welcome-banner" alignment="CENTER_LEFT" spacing="18">
            <VBox spacing="8">
                <Label fx:id="eventTitleLabel" styleClass="welcome-title"/>
                <Label text="Consulte toutes les informations de cet evenement avant de t'inscrire."
                       styleClass="welcome-subtitle" wrapText="true"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Retour a la liste" styleClass="btn-secondary" onAction="#goToEvents"/>
        </HBox>

        <HBox spacing="14">
            <VBox styleClass="stat-card, stat-blue" spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Statut" styleClass="stat-label"/>
                <Label fx:id="statusLabel" styleClass="stat-value"/>
                <Label text="Etat actuel de l'evenement" styleClass="stat-sub"/>
            </VBox>
            <VBox styleClass="stat-card, stat-green" spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Debut" styleClass="stat-label"/>
                <Label fx:id="startLabel" styleClass="stat-value"/>
                <Label text="Date de debut" styleClass="stat-sub"/>
            </VBox>
            <VBox styleClass="stat-card, stat-purple" spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Fin" styleClass="stat-label"/>
                <Label fx:id="endLabel" styleClass="stat-value"/>
                <Label text="Date de fin" styleClass="stat-sub"/>
            </VBox>
        </HBox>

        <VBox styleClass="card, event-detail-card" spacing="16">
            <Label text="Informations generales" styleClass="card-title, event-detail-card-title"/>
            <Label text="Lieu" styleClass="info-label, event-detail-label"/>
            <Label fx:id="locationLabel" styleClass="info-value, event-detail-value"/>
            <VBox styleClass="map-panel" spacing="8">
                <Label text="CARTE DU LIEU" styleClass="weather-detail-title"/>
                <Label fx:id="mapStatusLabel" wrapText="true" styleClass="tip-text, event-detail-text" text="Chargement de la carte..."/>
                <WebView fx:id="locationMapView" prefHeight="220" minHeight="220"/>
            </VBox>
            <Label text="Description" styleClass="info-label, event-detail-label"/>
            <Label fx:id="descriptionLabel" wrapText="true" styleClass="tip-text, event-detail-text, event-description-text"/>
            <VBox styleClass="weather-detail-panel" spacing="6">
                <Label text="METEO EN DIRECT" styleClass="weather-detail-title"/>
                <Label fx:id="weatherLabel" wrapText="true" styleClass="weather-detail-value, event-detail-weather-value" text="Chargement meteo..."/>
            </VBox>
            <VBox styleClass="weather-detail-panel" spacing="6">
                <Label text="JOUR FERIE (TUNISIE)" styleClass="weather-detail-title"/>
                <Label fx:id="holidayLabel" wrapText="true" styleClass="weather-detail-value, event-detail-weather-value" text="Verification..."/>
            </VBox>
            <HBox spacing="10">
                <Button fx:id="registerButton" text="S'inscrire a cet evenement" styleClass="btn-primary" onAction="#handleRegister"/>
                <Button fx:id="cancelRegistrationButton" text="Annuler mon inscription" styleClass="btn-secondary" onAction="#handleCancelRegistration"/>
                <Button text="Mes inscriptions" styleClass="btn-secondary" onAction="#goToMyRegistrations"/>
            </HBox>
            <Label fx:id="messageLabel" styleClass="inline-helper-label, event-detail-helper" wrapText="true"/>
        </VBox>

        <VBox styleClass="card, event-detail-card" spacing="14">
            <Label text="Exercices de l'evenement" styleClass="card-title, event-detail-card-title"/>
            <VBox fx:id="videoPanel" styleClass="video-panel" spacing="10" managed="true" visible="true" alignment="TOP_CENTER">
                <Label text="TUTORIEL VIDEO" styleClass="video-title"/>
                <HBox alignment="CENTER" spacing="10">
                    <Button fx:id="openVideoButton" text="Ouvrir la video" styleClass="btn-primary"/>
                </HBox>
                <Label fx:id="videoStatusLabel" styleClass="tip-text" wrapText="true" text="Selectionnez un exercice pour voir la video"/>
            </VBox>
            <TableView fx:id="exercisesTable" VBox.vgrow="ALWAYS" styleClass="dashboard-table, exercises-main-table" onMouseClicked="#handleExerciseSelected">
                <columns>
                    <TableColumn fx:id="exNomCol" text="Exercice" prefWidth="320"/>
                    <TableColumn fx:id="exDureeCol" text="Duree (min)" prefWidth="160"/>
                    <TableColumn fx:id="exRepCol" text="Repetitions" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
