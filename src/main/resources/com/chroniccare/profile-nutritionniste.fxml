<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.chroniccare.controllers.ProfileNutritionnnisteController"
            prefWidth="1100" prefHeight="700"
            stylesheets="@home-styles.css">

    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="+" styleClass="brand-icon"/>
                    <Label text="ChronicCare" styleClass="brand-title"/>
                </HBox>
                <Label text="Suivi médical intelligent" styleClass="brand-subtitle"/>
            </VBox>
            <VBox styleClass="sidebar-user-card" spacing="6">
                <Label fx:id="sidebarAvatar" styleClass="sidebar-avatar"/>
                <Label fx:id="sidebarUserName" styleClass="sidebar-user-name"/>
                <Label text="Nutritionniste" styleClass="sidebar-role-badge"
                       style="-fx-text-fill: #fbbf24; -fx-background-color: #78350f;"/>
            </VBox>
            <Separator styleClass="sidebar-sep"/>
            <VBox styleClass="nav-section" spacing="2" VBox.vgrow="ALWAYS">
                <Label text="NAVIGATION" styleClass="nav-section-label"/>
                <Button text="Accueil" styleClass="nav-btn"
                        onAction="#goToHome" maxWidth="Infinity"/>
                <Button text="Mon profil" styleClass="nav-btn, nav-btn-active"
                        maxWidth="Infinity"/>
                <Button text="RDV" styleClass="nav-btn"
                        onAction="#goToRdv" maxWidth="Infinity"/>
            </VBox>
            <VBox styleClass="sidebar-bottom">
                <Separator styleClass="sidebar-sep"/>
                <Button text="Déconnexion" styleClass="nav-btn, nav-btn-logout"
                        onAction="#handleLogout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content" spacing="0">
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <Label text="Mon profil nutritionniste" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="topbarDate" styleClass="topbar-date"/>
                <HBox styleClass="topbar-user-pill" alignment="CENTER" spacing="8">
                    <Label fx:id="topbarAvatar" styleClass="topbar-avatar"/>
                    <Label fx:id="topbarUserName" styleClass="topbar-username"/>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll">
                <VBox spacing="20" styleClass="dashboard-body">
                    <HBox styleClass="welcome-banner" alignment="CENTER_LEFT" spacing="18">
                        <VBox spacing="8">
                            <Label text="Ton espace profil nutritionniste" styleClass="welcome-title"/>
                            <Label text="Mets à jour tes informations pour garder un compte fiable et professionnel."
                                   styleClass="welcome-subtitle" wrapText="true"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Nutritionniste" styleClass="status-chip, status-chip-pending"/>
                    </HBox>

                    <HBox spacing="14">
                        <VBox styleClass="stat-card, stat-blue" spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Statut du compte" styleClass="stat-label"/>
                            <Label fx:id="statusLabel" styleClass="stat-value"/>
                            <Label text="Validation de ton profil nutritionniste" styleClass="stat-sub"/>
                        </VBox>
                        <VBox styleClass="stat-card, stat-green" spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Complétude profil" styleClass="stat-label"/>
                            <Label fx:id="completionLabel" styleClass="stat-value"/>
                            <Label text="Champs personnels renseignés" styleClass="stat-sub"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="20">
                        <VBox styleClass="card, profile-card" spacing="16" HBox.hgrow="ALWAYS">
                            <Label text="Informations personnelles" styleClass="card-title"/>
                            <Separator/>
                            <HBox spacing="16">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Nom" styleClass="info-label"/>
                                    <TextField fx:id="nomField" promptText="Votre nom" styleClass="filter-field"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Prénom" styleClass="info-label"/>
                                    <TextField fx:id="prenomField" promptText="Votre prénom" styleClass="filter-field"/>
                                </VBox>
                            </HBox>
                            <VBox spacing="6">
                                <Label text="Email" styleClass="info-label"/>
                                <TextField fx:id="emailField" promptText="Votre email" styleClass="filter-field"/>
                            </VBox>
                            <HBox spacing="16">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Téléphone" styleClass="info-label"/>
                                    <TextField fx:id="telephoneField" promptText="8 chiffres" styleClass="filter-field"/>
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="Genre" styleClass="info-label"/>
                                    <ComboBox fx:id="genreCombo" maxWidth="Infinity" styleClass="filter-combo"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox styleClass="card, profile-side-card" spacing="16" prefWidth="320">
                            <Label text="Informations professionnelles" styleClass="card-title"/>
                            <Separator/>
                            <VBox spacing="6">
                                <Label text="Statut d'approbation" styleClass="info-label"/>
                                <Label fx:id="approvalLabel" styleClass="info-value"/>
                            </VBox>
                            <VBox styleClass="tip-item" spacing="6">
                                <Label text="Rôle nutritionniste" styleClass="tip-title"/>
                                <Label text="Tu accompagnes les patients dans leurs habitudes alimentaires avec un suivi personnalisé."
                                       styleClass="tip-text" wrapText="true"/>
                            </VBox>
                            <VBox styleClass="tip-item" spacing="6">
                                <Label text="Bonnes pratiques" styleClass="tip-title"/>
                                <Label text="Utilise un email valide et un téléphone complet pour fluidifier les échanges."
                                       styleClass="tip-text" wrapText="true"/>
                            </VBox>
                        </VBox>
                    </HBox>

                    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false"/>
                    <Label fx:id="successLabel" styleClass="success-label" wrapText="true" visible="false" managed="false"/>

                    <Button text="Enregistrer les modifications"
                            styleClass="btn-primary, profile-save-btn"
                            onAction="#handleSave"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
