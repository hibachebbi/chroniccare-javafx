<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.chroniccare.controllers.EventParticipantsController"
            prefWidth="1200" prefHeight="760"
            stylesheets="@home-styles.css">

    <left>
        <VBox styleClass="sidebar" prefWidth="230" spacing="0">
            <VBox styleClass="sidebar-brand" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="+" styleClass="brand-icon"/>
                    <Label text="ChronicCare" styleClass="brand-title"/>
                </HBox>
                <Label text="Suivi medical intelligent" styleClass="brand-subtitle"/>
            </VBox>
            <VBox styleClass="sidebar-user-card" spacing="6" alignment="CENTER_LEFT">
                <Label fx:id="sidebarAvatar" styleClass="sidebar-avatar"/>
                <Label fx:id="sidebarUserName" styleClass="sidebar-user-name"/>
                <Label text="Coach" styleClass="sidebar-role-badge, sidebar-role-coach"/>
            </VBox>
            <Separator styleClass="sidebar-sep"/>
            <VBox styleClass="nav-section" spacing="2" VBox.vgrow="ALWAYS">
                <Button text="Evenements" styleClass="nav-btn, nav-btn-active" onAction="#goToEvents" maxWidth="Infinity"/>
                <Button text="Exercices" styleClass="nav-btn" onAction="#goToExercises" maxWidth="Infinity"/>
                <Button text="Mon Etat" styleClass="nav-btn" onAction="#goToHomeEtat" maxWidth="Infinity"/>
                <Button text="Activite" styleClass="nav-btn" onAction="#goToHomeActivite" maxWidth="Infinity"/>
                <Button text="Mon Profil" styleClass="nav-btn" onAction="#goToProfile" maxWidth="Infinity"/>
            </VBox>
            <VBox styleClass="sidebar-bottom">
                <Separator styleClass="sidebar-sep"/>
                <Button text="Deconnexion" styleClass="nav-btn, nav-btn-logout"
                        onAction="#handleLogout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content" spacing="0">
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <Label text="Patients inscrits" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="topbarDate" styleClass="topbar-date"/>
                <HBox styleClass="topbar-user-pill" alignment="CENTER" spacing="8">
                    <Label fx:id="topbarAvatar" styleClass="topbar-avatar"/>
                    <Label fx:id="topbarUserName" styleClass="topbar-username"/>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll">
                <VBox spacing="20" styleClass="dashboard-body">
                    <VBox styleClass="card" spacing="14">
                        <Label fx:id="eventTitleLabel" text="Événement" styleClass="card-title"/>
                        <Label fx:id="eventMetaLabel" styleClass="tip-text" wrapText="true"/>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <TextField fx:id="searchField" promptText="Rechercher un participant..."
                                       HBox.hgrow="ALWAYS" styleClass="filter-field"/>
                            <Button text="Rechercher" styleClass="btn-primary" onAction="#handleSearch"/>
                            <Button fx:id="exportCsvButton" text="Exporter CSV" styleClass="btn-secondary" onAction="#handleExportCsv"/>
                            <Button text="Réinitialiser" styleClass="btn-secondary" onAction="#handleReset"/>
                            <Button text="Retour aux événements" styleClass="btn-secondary" onAction="#goToEvents"/>
                        </HBox>

                        <TableView fx:id="participantsTable" VBox.vgrow="ALWAYS" styleClass="dashboard-table">
                            <columns>
                                <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="nomCol" text="Nom" prefWidth="140"/>
                                <TableColumn fx:id="prenomCol" text="Prénom" prefWidth="140"/>
                                <TableColumn fx:id="emailCol" text="Email" prefWidth="250"/>
                                <TableColumn fx:id="telephoneCol" text="Téléphone" prefWidth="130"/>
                                <TableColumn fx:id="createdAtCol" text="Date inscription" prefWidth="180"/>
                            </columns>
                        </TableView>

                        <Label fx:id="countLabel" styleClass="info-label"/>
                        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
