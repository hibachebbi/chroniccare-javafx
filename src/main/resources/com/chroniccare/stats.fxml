<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.chroniccare.controllers.StatsController"
      fitToWidth="true" styleClass="content-scroll"
      stylesheets="@home-styles.css">
    <VBox spacing="24" styleClass="dashboard-body">
        <HBox spacing="16">
            <VBox styleClass="stat-card, stat-blue" spacing="8" HBox.hgrow="ALWAYS">
                <Label text="👥  Total utilisateurs" styleClass="stat-label"/>
                <Label fx:id="statTotal" text="—" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card, stat-green" spacing="8" HBox.hgrow="ALWAYS">
                <Label text="🧑  Hommes" styleClass="stat-label"/>
                <Label fx:id="statHommes" text="—" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card, stat-purple" spacing="8" HBox.hgrow="ALWAYS">
                <Label text="👩  Femmes" styleClass="stat-label"/>
                <Label fx:id="statFemmes" text="—" styleClass="stat-value"/>
            </VBox>
        </HBox>
        <HBox spacing="16" alignment="TOP_LEFT">
            <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🎭" styleClass="card-icon"/>
                    <Label text="Répartition par rôle" styleClass="card-title"/>
                </HBox>
                <Separator/>
                <Canvas fx:id="canvasRoles" width="380" height="280"/>
                <VBox fx:id="legendeRoles" spacing="6"/>
            </VBox>
            <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="⚧" styleClass="card-icon"/>
                    <Label text="Répartition par genre" styleClass="card-title"/>
                </HBox>
                <Separator/>
                <Canvas fx:id="canvasGenre" width="380" height="280"/>
                <VBox fx:id="legendeGenre" spacing="6"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
